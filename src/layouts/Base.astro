---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, EMAIL, telefonoE164 } from '../data/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  /* JSON-LD propio de la página (p. ej. el FAQPage de la home). Solo debe
     describir contenido que esa página muestra. */
  jsonLd?: readonly Record<string, unknown>[];
}

const {
  titulo = SITE.titulo,
  descripcion = SITE.descripcion,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImagen = new URL(SITE.ogImagen, Astro.site).href;

const jsonLdOrganizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.nombre,
  description: SITE.descripcionOrg,
  /* La organización es la misma en todas las páginas: su url es la raíz,
     no la canonical de la página que se está viendo. */
  url: new URL('/', Astro.site).href,
  email: EMAIL,
  telephone: telefonoE164,
  logo: new URL('/favicon.svg', Astro.site).href,
};

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      href="/fonts/manrope-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLdOrganizacion)}
    />
    {
      jsonLd.map((datos) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(datos)}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <CookieNotice />
  </body>
</html>
