---
import s from './Nav.module.css';
import Logo from './icons/Logo.astro';
import { NAV, CTA_NAV, SITE, whatsappUrl } from '../data/site';
---

<header class={s.cabecera}>
  <div class={s.interior}>
    <a class={s.marca} href="/">
      <Logo size={28} decorativo />
      <span class={s.wordmark}>{SITE.nombre}</span>
    </a>

    <nav class={s.menuEscritorio} aria-label="Principal">
      {
        NAV.map(({ texto, href }) => (
          <a class={s.enlace} href={href}>
            {texto}
          </a>
        ))
      }
      <a class={s.cta} href={whatsappUrl} target="_blank" rel="noopener">
        {CTA_NAV}
      </a>
    </nav>

    <button
      class={s.hamburguesa}
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Abrir menú"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

{
  /* El panel va FUERA del <header> a propósito. La cabecera lleva
     backdrop-filter, y un elemento con backdrop-filter distinto de none se
     convierte en el bloque contenedor de sus descendientes position: fixed:
     dentro del header, el inset: 0 del panel se resolvía contra la caja del
     nav y quedaba recortado a su altura. aria-controls funciona igual entre
     ramas distintas del DOM. */
}
<div class={s.panel} id="nav-panel" hidden>
  <div class={s.panelCabecera}>
    <a class={s.marca} href="/">
      <Logo size={28} decorativo />
      <span class={s.wordmark}>{SITE.nombre}</span>
    </a>
    <button
      class={s.cerrar}
      id="nav-cerrar"
      type="button"
      aria-label="Cerrar menú"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="square"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>

  <nav class={s.menuMovil} aria-label="Principal">
    {
      NAV.map(({ texto, href }) => (
        <a class={s.enlaceMovil} href={href}>
          {texto}
        </a>
      ))
    }
    <a class={s.ctaMovil} href={whatsappUrl} target="_blank" rel="noopener">
      {CTA_NAV}
    </a>
  </nav>
</div>

<script>
  function iniciarMenu(
    toggle: HTMLElement,
    panel: HTMLElement,
    cerrarBtn: HTMLElement
  ) {
    const escritorio = window.matchMedia('(min-width: 900px)');

    // El estado se lee del DOM en vez de guardarse en una variable: así no
    // puede desincronizarse de lo que el usuario ve.
    const estaAbierto = () => !panel.hidden;

    // Enfocables del panel en orden de DOM (logo, cerrar, enlaces, CTA): el
    // trap envuelve del último al primero y viceversa, así que el orden tiene
    // que ser el mismo que sigue Tab. Al abrir, el foco va al botón de cerrar
    // aunque no sea el primero. El toggle queda tapado por el panel, así que
    // no entra: se le llega cerrando.
    const enfocables = () => [
      ...panel.querySelectorAll<HTMLElement>('a[href], button'),
    ];

    // Todo lo que no sea el panel queda fuera de foco y del árbol de
    // accesibilidad mientras está abierto.
    const hermanos = () =>
      [...document.body.children].filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== panel
      );

    const alPulsarTecla = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        cerrar();
        return;
      }
      if (e.key !== 'Tab') return;

      const lista = enfocables();
      const primero = lista[0];
      const ultimo = lista[lista.length - 1];

      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    };

    function abrir() {
      if (estaAbierto() || escritorio.matches) return;
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      hermanos().forEach((el) => (el.inert = true));
      document.body.style.overflow = 'hidden';
      // iOS Safari no siempre bloquea el scroll solo con body
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', alPulsarTecla);
      cerrarBtn.focus();
    }

    function cerrar(devolverFoco = true) {
      if (!estaAbierto()) return;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      hermanos().forEach((el) => (el.inert = false));
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', alPulsarTecla);
      if (devolverFoco) toggle.focus();
    }

    toggle.addEventListener('click', abrir);
    cerrarBtn.addEventListener('click', () => cerrar());

    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) cerrar(false);
    });

    // Si se cruza el breakpoint con el panel abierto hay que cerrarlo: en
    // escritorio no hay hamburguesa a la que volver. Se escuchan los dos
    // eventos porque 'change' de matchMedia no siempre llega cuando el
    // viewport cambia sin que el usuario redimensione la ventana.
    const reconciliar = () => {
      if (escritorio.matches) cerrar(false);
    };
    escritorio.addEventListener('change', reconciliar);
    window.addEventListener('resize', reconciliar, { passive: true });
  }

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const cerrarBtn = document.getElementById('nav-cerrar');
  if (toggle && panel && cerrarBtn) iniciarMenu(toggle, panel, cerrarBtn);
</script>
