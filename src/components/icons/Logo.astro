---
import s from './Logo.module.css';

interface Props {
  size?: number;
  /* true = va acompañado de un wordmark textual, así que no debe anunciarse
     dos veces al lector de pantalla. */
  decorativo?: boolean;
}

const { size = 28, decorativo = false } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 28 28"
  xmlns="http://www.w3.org/2000/svg"
  role={decorativo ? undefined : 'img'}
  aria-hidden={decorativo ? 'true' : undefined}
  focusable="false"
>
  {!decorativo && <title>Tiendoa</title>}
  <rect class={s.marca} x="5" y="6" width="18" height="3.2" />
  <rect class={s.marca} x="12.4" y="6" width="3.2" height="17" />
  <rect class={s.punto} x="19.7" y="19.7" width="3.8" height="3.8" />
</svg>
