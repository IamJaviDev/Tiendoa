---
interface Props {
  size?: number;
}

const { size = 39 } = Astro.props;
---

<!-- Ventana de navegador: caja de trazo 2.5 + barra superior sólida de 9px por
     dentro del borde, con las esquinas de arriba siguiendo el radio interior
     (3 − 2.5 = 0.5). -->
<svg
  width={size}
  height={size}
  viewBox="0 0 39 39"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="1.25"
    y="1.25"
    width="36.5"
    height="36.5"
    rx="1.75"
    stroke="currentColor"
    stroke-width="2.5"
  />
  <path
    d="M2.5 11.5 V3 A0.5 0.5 0 0 1 3 2.5 H36 A0.5 0.5 0 0 1 36.5 3 V11.5 Z"
    fill="currentColor"
  />
</svg>
