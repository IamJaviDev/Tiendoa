---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LogosStrip from '../components/LogosStrip.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import PorQue from '../components/PorQue.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero variante="claro" />
    {/* Oculta hasta tener logos y cifras reales de clientes. */}
    <LogosStrip mostrar={false} />
    <Servicios />
    <Proceso />
    <PorQue />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
</Base>
